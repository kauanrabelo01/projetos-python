print('Olá, essa é sua calculadora funcional!')

num1 = float(input('Digite seu primeiro número '))
num2 = float(input('Digite seu segundo número '))
op = input('Digite a operação que você deseja: +,-,*,/ ')

if op == '+':
    print(num1 + num2)
elif op == '-':
    print(num1 - num2)
elif op == '*':
    print(num1 * num2)
elif op == '/':
    print(num1 / num2)